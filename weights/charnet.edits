# WP-CharNet weights, programmed directly: every nonzero parameter comes from a line below
# No training, no fine-tuning, no weights or statistics taken from any dataset.

# ---- L1 ink: 0 below grey 0.25, 1 above grey 0.5 ---------------------------
TAP L1 ink x 0 0 4
BIAS L1 ink -1   # ink = clip(4x - 1): anti-aliased edges count as half ink
TAP L1 ink_core x 0 0 5
BIAS L1 ink_core -3.5   # ink_core = only near-white pixels (>= 0.9): the grey inside a tight loop is not a wall

# ---- L2 strokes: a run detector fires only if every pixel of its line is ink (AND via bias) 
TAP L2 run_h ink_fat 0 -4 1
TAP L2 run_h ink_fat 0 -3 1
TAP L2 run_h ink_fat 0 -2 1
TAP L2 run_h ink_fat 0 -1 1
TAP L2 run_h ink_fat 0 0 1
TAP L2 run_h ink_fat 0 1 1
TAP L2 run_h ink_fat 0 2 1
TAP L2 run_h ink_fat 0 3 1
TAP L2 run_h ink_fat 0 4 1
BIAS L2 run_h -8   # run_h: 9 pixels of thickened ink in a row
TAP L2 run_v ink_fat -4 0 1
TAP L2 run_v ink_fat -3 0 1
TAP L2 run_v ink_fat -2 0 1
TAP L2 run_v ink_fat -1 0 1
TAP L2 run_v ink_fat 0 0 1
TAP L2 run_v ink_fat 1 0 1
TAP L2 run_v ink_fat 2 0 1
TAP L2 run_v ink_fat 3 0 1
TAP L2 run_v ink_fat 4 0 1
BIAS L2 run_v -8   # run_v: 9 pixels of thickened ink in a row
TAP L2 run_d1 ink_fat 4 -4 1
TAP L2 run_d1 ink_fat 3 -3 1
TAP L2 run_d1 ink_fat 2 -2 1
TAP L2 run_d1 ink_fat 1 -1 1
TAP L2 run_d1 ink_fat 0 0 1
TAP L2 run_d1 ink_fat -1 1 1
TAP L2 run_d1 ink_fat -2 2 1
TAP L2 run_d1 ink_fat -3 3 1
TAP L2 run_d1 ink_fat -4 4 1
BIAS L2 run_d1 -8   # run_d1: 9 pixels of thickened ink in a row
TAP L2 run_d2 ink_fat -4 -4 1
TAP L2 run_d2 ink_fat -3 -3 1
TAP L2 run_d2 ink_fat -2 -2 1
TAP L2 run_d2 ink_fat -1 -1 1
TAP L2 run_d2 ink_fat 0 0 1
TAP L2 run_d2 ink_fat 1 1 1
TAP L2 run_d2 ink_fat 2 2 1
TAP L2 run_d2 ink_fat 3 3 1
TAP L2 run_d2 ink_fat 4 4 1
BIAS L2 run_d2 -8   # run_d2: 9 pixels of thickened ink in a row

# ---- L2 stroke ends: stroke behind, nothing ahead, nothing beside ----------
TAP L2 end_up ink 0 0 1
TAP L2 end_up ink 1 0 1
TAP L2 end_up ink 2 0 1
TAP L2 end_up ink 3 0 1
TAP L2 end_up ink 4 0 1
TAP L2 end_up ink -3 -2 -2
TAP L2 end_up ink -3 -1 -2
TAP L2 end_up ink -3 0 -2
TAP L2 end_up ink -3 1 -2
TAP L2 end_up ink -3 2 -2
TAP L2 end_up ink -2 -2 -2
TAP L2 end_up ink -2 -1 -2
TAP L2 end_up ink -2 0 -2
TAP L2 end_up ink -2 1 -2
TAP L2 end_up ink -2 2 -2
TAP L2 end_up ink -1 -2 -2
TAP L2 end_up ink -1 -1 -2
TAP L2 end_up ink -1 0 -2
TAP L2 end_up ink -1 1 -2
TAP L2 end_up ink -1 2 -2
TAP L2 end_up ink 0 -4 -2
TAP L2 end_up ink 0 4 -2
TAP L2 end_up ink 3 -4 -1
TAP L2 end_up ink 3 4 -1
TAP L2 end_up ink 4 -4 -1
TAP L2 end_up ink 4 4 -1
BIAS L2 end_up -4   # end_up: 5 px of stroke behind; empty: 15 px ahead, 2 beside, 4 at the shoulders
TAP L2 end_down ink -4 0 1
TAP L2 end_down ink -3 0 1
TAP L2 end_down ink -2 0 1
TAP L2 end_down ink -1 0 1
TAP L2 end_down ink 0 0 1
TAP L2 end_down ink 1 -2 -2
TAP L2 end_down ink 1 -1 -2
TAP L2 end_down ink 1 0 -2
TAP L2 end_down ink 1 1 -2
TAP L2 end_down ink 1 2 -2
TAP L2 end_down ink 2 -2 -2
TAP L2 end_down ink 2 -1 -2
TAP L2 end_down ink 2 0 -2
TAP L2 end_down ink 2 1 -2
TAP L2 end_down ink 2 2 -2
TAP L2 end_down ink 3 -2 -2
TAP L2 end_down ink 3 -1 -2
TAP L2 end_down ink 3 0 -2
TAP L2 end_down ink 3 1 -2
TAP L2 end_down ink 3 2 -2
TAP L2 end_down ink 0 -4 -2
TAP L2 end_down ink 0 4 -2
TAP L2 end_down ink -4 -4 -1
TAP L2 end_down ink -4 4 -1
TAP L2 end_down ink -3 -4 -1
TAP L2 end_down ink -3 4 -1
BIAS L2 end_down -4   # end_down: 5 px of stroke behind; empty: 15 px ahead, 2 beside, 4 at the shoulders
TAP L2 end_left ink 0 0 1
TAP L2 end_left ink 0 1 1
TAP L2 end_left ink 0 2 1
TAP L2 end_left ink 0 3 1
TAP L2 end_left ink 0 4 1
TAP L2 end_left ink -2 -3 -2
TAP L2 end_left ink -2 -2 -2
TAP L2 end_left ink -2 -1 -2
TAP L2 end_left ink -1 -3 -2
TAP L2 end_left ink -1 -2 -2
TAP L2 end_left ink -1 -1 -2
TAP L2 end_left ink 0 -3 -2
TAP L2 end_left ink 0 -2 -2
TAP L2 end_left ink 0 -1 -2
TAP L2 end_left ink 1 -3 -2
TAP L2 end_left ink 1 -2 -2
TAP L2 end_left ink 1 -1 -2
TAP L2 end_left ink 2 -3 -2
TAP L2 end_left ink 2 -2 -2
TAP L2 end_left ink 2 -1 -2
TAP L2 end_left ink -4 0 -2
TAP L2 end_left ink 4 0 -2
TAP L2 end_left ink -4 3 -1
TAP L2 end_left ink -4 4 -1
TAP L2 end_left ink 4 3 -1
TAP L2 end_left ink 4 4 -1
BIAS L2 end_left -4   # end_left: 5 px of stroke behind; empty: 15 px ahead, 2 beside, 4 at the shoulders
TAP L2 end_right ink 0 -4 1
TAP L2 end_right ink 0 -3 1
TAP L2 end_right ink 0 -2 1
TAP L2 end_right ink 0 -1 1
TAP L2 end_right ink 0 0 1
TAP L2 end_right ink -2 1 -2
TAP L2 end_right ink -2 2 -2
TAP L2 end_right ink -2 3 -2
TAP L2 end_right ink -1 1 -2
TAP L2 end_right ink -1 2 -2
TAP L2 end_right ink -1 3 -2
TAP L2 end_right ink 0 1 -2
TAP L2 end_right ink 0 2 -2
TAP L2 end_right ink 0 3 -2
TAP L2 end_right ink 1 1 -2
TAP L2 end_right ink 1 2 -2
TAP L2 end_right ink 1 3 -2
TAP L2 end_right ink 2 1 -2
TAP L2 end_right ink 2 2 -2
TAP L2 end_right ink 2 3 -2
TAP L2 end_right ink -4 0 -2
TAP L2 end_right ink 4 0 -2
TAP L2 end_right ink -4 -4 -1
TAP L2 end_right ink -4 -3 -1
TAP L2 end_right ink 4 -4 -1
TAP L2 end_right ink 4 -3 -1
BIAS L2 end_right -4   # end_right: 5 px of stroke behind; empty: 15 px ahead, 2 beside, 4 at the shoulders
TAP L2 end_ul ink 0 0 1
TAP L2 end_ul ink 1 1 1
TAP L2 end_ul ink 2 2 1
TAP L2 end_ul ink 3 3 1
TAP L2 end_ul ink -3 -1 -2
TAP L2 end_ul ink -3 0 -2
TAP L2 end_ul ink -2 -2 -2
TAP L2 end_ul ink -2 -1 -2
TAP L2 end_ul ink -2 0 -2
TAP L2 end_ul ink -1 -3 -2
TAP L2 end_ul ink -1 -2 -2
TAP L2 end_ul ink -1 -1 -2
TAP L2 end_ul ink 0 -3 -2
TAP L2 end_ul ink 0 -2 -2
TAP L2 end_ul ink -3 2 -2
TAP L2 end_ul ink -3 3 -2
TAP L2 end_ul ink -2 3 -2
TAP L2 end_ul ink 2 -3 -2
TAP L2 end_ul ink 3 -3 -2
TAP L2 end_ul ink 3 -2 -2
BIAS L2 end_ul -3   # end_ul: 4 px of stroke behind; empty: 10 px ahead, 6 beside, 0 at the shoulders
TAP L2 end_ur ink 0 0 1
TAP L2 end_ur ink 1 -1 1
TAP L2 end_ur ink 2 -2 1
TAP L2 end_ur ink 3 -3 1
TAP L2 end_ur ink -3 0 -2
TAP L2 end_ur ink -3 1 -2
TAP L2 end_ur ink -2 0 -2
TAP L2 end_ur ink -2 1 -2
TAP L2 end_ur ink -2 2 -2
TAP L2 end_ur ink -1 1 -2
TAP L2 end_ur ink -1 2 -2
TAP L2 end_ur ink -1 3 -2
TAP L2 end_ur ink 0 2 -2
TAP L2 end_ur ink 0 3 -2
TAP L2 end_ur ink -3 -3 -2
TAP L2 end_ur ink -3 -2 -2
TAP L2 end_ur ink -2 -3 -2
TAP L2 end_ur ink 2 3 -2
TAP L2 end_ur ink 3 2 -2
TAP L2 end_ur ink 3 3 -2
BIAS L2 end_ur -3   # end_ur: 4 px of stroke behind; empty: 10 px ahead, 6 beside, 0 at the shoulders
TAP L2 end_dl ink -3 3 1
TAP L2 end_dl ink -2 2 1
TAP L2 end_dl ink -1 1 1
TAP L2 end_dl ink 0 0 1
TAP L2 end_dl ink 0 -3 -2
TAP L2 end_dl ink 0 -2 -2
TAP L2 end_dl ink 1 -3 -2
TAP L2 end_dl ink 1 -2 -2
TAP L2 end_dl ink 1 -1 -2
TAP L2 end_dl ink 2 -2 -2
TAP L2 end_dl ink 2 -1 -2
TAP L2 end_dl ink 2 0 -2
TAP L2 end_dl ink 3 -1 -2
TAP L2 end_dl ink 3 0 -2
TAP L2 end_dl ink -3 -3 -2
TAP L2 end_dl ink -3 -2 -2
TAP L2 end_dl ink -2 -3 -2
TAP L2 end_dl ink 2 3 -2
TAP L2 end_dl ink 3 2 -2
TAP L2 end_dl ink 3 3 -2
BIAS L2 end_dl -3   # end_dl: 4 px of stroke behind; empty: 10 px ahead, 6 beside, 0 at the shoulders
TAP L2 end_dr ink -3 -3 1
TAP L2 end_dr ink -2 -2 1
TAP L2 end_dr ink -1 -1 1
TAP L2 end_dr ink 0 0 1
TAP L2 end_dr ink 0 2 -2
TAP L2 end_dr ink 0 3 -2
TAP L2 end_dr ink 1 1 -2
TAP L2 end_dr ink 1 2 -2
TAP L2 end_dr ink 1 3 -2
TAP L2 end_dr ink 2 0 -2
TAP L2 end_dr ink 2 1 -2
TAP L2 end_dr ink 2 2 -2
TAP L2 end_dr ink 3 0 -2
TAP L2 end_dr ink 3 1 -2
TAP L2 end_dr ink -3 2 -2
TAP L2 end_dr ink -3 3 -2
TAP L2 end_dr ink -2 3 -2
TAP L2 end_dr ink 2 -3 -2
TAP L2 end_dr ink 3 -3 -2
TAP L2 end_dr ink 3 -2 -2
BIAS L2 end_dr -3   # end_dr: 4 px of stroke behind; empty: 10 px ahead, 6 beside, 0 at the shoulders

# ---- L3S stroke edges: ink whose neighbour on one side is background -------
TAP L3S eR ink 0 0 1
TAP L3S eR ink 0 1 -1   # eR: the stroke ends at this pixel on that side
TAP L3S eL ink 0 0 1
TAP L3S eL ink 0 -1 -1   # eL: the stroke ends at this pixel on that side
TAP L3S eB ink 0 0 1
TAP L3S eB ink 1 0 -1   # eB: the stroke ends at this pixel on that side
TAP L3S eT ink 0 0 1
TAP L3S eT ink -1 0 -1   # eT: the stroke ends at this pixel on that side

# ---- L3R relational strokes: a run, minus/plus the rays just beside it -----
TAP L3R edge_l run_v 0 0 1
TAP L3R edge_l sepL 0 0 -2
BIAS L3R edge_l 0   # vertical stroke with no other stroke to its left (left stem or side)
TAP L3R edge_r run_v 0 0 1
TAP L3R edge_r sepR 0 0 -2
BIAS L3R edge_r 0   # vertical stroke with no other stroke to its right
TAP L3R edge_t run_h 0 0 1
TAP L3R edge_t sepU 0 0 -2
BIAS L3R edge_t 0   # horizontal stroke with no other stroke above it (top bar, top of a curve)
TAP L3R edge_b run_h 0 0 1
TAP L3R edge_b sepD 0 0 -2
BIAS L3R edge_b 0   # horizontal stroke with no other stroke below it
TAP L3R mid_h run_h 0 0 1
TAP L3R mid_h sepU 0 0 1
TAP L3R mid_h sepD 0 0 1
BIAS L3R mid_h -2   # horizontal stroke with other strokes above and below (E, H, A, 4)
TAP L3R mid_v run_v 0 0 1
TAP L3R mid_v sepL 0 0 1
TAP L3R mid_v sepR 0 0 1
BIAS L3R mid_v -2   # vertical stroke with other strokes on both sides (m, 4, t, Y)

# ---- LX1 stroke starts along rows / columns, and side margins --------------
TAP LX1 start_h ink 0 0 1
TAP LX1 start_h ink 0 -1 -1   # ink rises from the left neighbour: a stroke starts here (row scan)
TAP LX1 start_v ink 0 0 1
TAP LX1 start_v ink -1 0 -1   # ink rises from the pixel above: a stroke starts here (column scan)
TAP LX1 marg_l inkR 0 0 1
TAP LX1 marg_l inkL 0 0 -1
TAP LX1 marg_l ink 0 0 -1   # background left of the character on its row (left profile)
TAP LX1 marg_r inkL 0 0 1
TAP LX1 marg_r inkR 0 0 -1
TAP LX1 marg_r ink 0 0 -1   # background right of the character (right profile)
TAP LX1 marg_t inkD 0 0 1
TAP LX1 marg_t inkU 0 0 -1
TAP LX1 marg_t ink 0 0 -1   # background above the character in its column
TAP LX1 marg_b inkU 0 0 1
TAP LX1 marg_b inkD 0 0 -1
TAP LX1 marg_b ink 0 0 -1   # background below the character

# ---- LX4 crossing count >= k (soft step between k-0.75 and k-0.25: half-grey edges are not a stroke) 
TAP LX4 h_ge1 cnt_h 0 0 2
BIAS LX4 h_ge1 -0.5   # row crosses at least 1 strokes
TAP LX4 h_ge2 cnt_h 0 0 2
BIAS LX4 h_ge2 -2.5   # row crosses at least 2 strokes
TAP LX4 h_ge3 cnt_h 0 0 2
BIAS LX4 h_ge3 -4.5   # row crosses at least 3 strokes
TAP LX4 v_ge1 cnt_v 0 0 2
BIAS LX4 v_ge1 -0.5   # column crosses at least 1 strokes
TAP LX4 v_ge2 cnt_v 0 0 2
BIAS LX4 v_ge2 -2.5   # column crosses at least 2 strokes
TAP LX4 v_ge3 cnt_v 0 0 2
BIAS LX4 v_ge3 -4.5   # column crosses at least 3 strokes

# ---- LX5 crossing count exactly 1, exactly 2, 3 or more --------------------
TAP LX5 hx1 h_ge1 0 0 1
TAP LX5 hx1 h_ge2 0 0 -1   # hx1: exactly one stroke on this line
TAP LX5 hx2 h_ge2 0 0 1
TAP LX5 hx2 h_ge3 0 0 -1   # hx2: exactly two strokes (the two sides of a loop or a U)
TAP LX5 hx3 h_ge3 0 0 1   # hx3: three or more strokes (E, 3 and 5 read down a column)
TAP LX5 vx1 v_ge1 0 0 1
TAP LX5 vx1 v_ge2 0 0 -1   # vx1: exactly one stroke on this line
TAP LX5 vx2 v_ge2 0 0 1
TAP LX5 vx2 v_ge3 0 0 -1   # vx2: exactly two strokes (the two sides of a loop or a U)
TAP LX5 vx3 v_ge3 0 0 1   # vx3: three or more strokes (E, 3 and 5 read down a column)

# ---- LD1 stroke starts along / lines and \ lines ---------------------------
TAP LD1 start_d1 ink 0 0 1
TAP LD1 start_d1 ink -1 1 -1   # ink rises from the pixel up-right: a stroke starts here on its / line
TAP LD1 start_d2 ink 0 0 1
TAP LD1 start_d2 ink -1 -1 -1   # ink rises from the pixel up-left: a stroke starts here on its \ line

# ---- LD4 diagonal crossing count >= k (same soft step as the rows) ---------
TAP LD4 d1_ge1 cnt_d1 0 0 2
BIAS LD4 d1_ge1 -0.5   # the / line crosses at least 1 strokes
TAP LD4 d1_ge2 cnt_d1 0 0 2
BIAS LD4 d1_ge2 -2.5   # the / line crosses at least 2 strokes
TAP LD4 d1_ge3 cnt_d1 0 0 2
BIAS LD4 d1_ge3 -4.5   # the / line crosses at least 3 strokes
TAP LD4 d2_ge1 cnt_d2 0 0 2
BIAS LD4 d2_ge1 -0.5   # the backslash line crosses at least 1 strokes
TAP LD4 d2_ge2 cnt_d2 0 0 2
BIAS LD4 d2_ge2 -2.5   # the backslash line crosses at least 2 strokes
TAP LD4 d2_ge3 cnt_d2 0 0 2
BIAS LD4 d2_ge3 -4.5   # the backslash line crosses at least 3 strokes

# ---- LD5 diagonal crossing count exactly 1, exactly 2, 3 or more -----------
TAP LD5 ax1 d1_ge1 0 0 1
TAP LD5 ax1 d1_ge2 0 0 -1   # ax1: exactly one stroke on this diagonal
TAP LD5 ax2 d1_ge2 0 0 1
TAP LD5 ax2 d1_ge3 0 0 -1   # ax2: exactly two strokes
TAP LD5 ax3 d1_ge3 0 0 1   # ax3: three or more strokes
TAP LD5 bx1 d2_ge1 0 0 1
TAP LD5 bx1 d2_ge2 0 0 -1   # bx1: exactly one stroke on this diagonal
TAP LD5 bx2 d2_ge2 0 0 1
TAP LD5 bx2 d2_ge3 0 0 -1   # bx2: exactly two strokes
TAP LD5 bx3 d2_ge3 0 0 1   # bx3: three or more strokes

# ---- LJ0 ring ink: the grey fringe of a stroke counts as background --------
TAP LJ0 ink_ring ink 0 0 2
BIAS LJ0 ink_ring -1   # sharp ink: two arms leaving a crossing at a shallow angle stay apart (on thickened ink they merge and an 8's crossing reads as a plain stroke)

# ---- LJ1 ring steps: ink at ring point k but not at point k-1 (16 points, radius 5) 
TAP LJ1 arc0 ink_ring 0 5 1
TAP LJ1 arc0 ink_ring 2 5 -1   # arc0: a stroke crosses the ring between -1 and 0
TAP LJ1 arc1 ink_ring -2 5 1
TAP LJ1 arc1 ink_ring 0 5 -1   # arc1: a stroke crosses the ring between 0 and 1
TAP LJ1 arc2 ink_ring -4 4 1
TAP LJ1 arc2 ink_ring -2 5 -1   # arc2: a stroke crosses the ring between 1 and 2
TAP LJ1 arc3 ink_ring -5 2 1
TAP LJ1 arc3 ink_ring -4 4 -1   # arc3: a stroke crosses the ring between 2 and 3
TAP LJ1 arc4 ink_ring -5 0 1
TAP LJ1 arc4 ink_ring -5 2 -1   # arc4: a stroke crosses the ring between 3 and 4
TAP LJ1 arc5 ink_ring -5 -2 1
TAP LJ1 arc5 ink_ring -5 0 -1   # arc5: a stroke crosses the ring between 4 and 5
TAP LJ1 arc6 ink_ring -4 -4 1
TAP LJ1 arc6 ink_ring -5 -2 -1   # arc6: a stroke crosses the ring between 5 and 6
TAP LJ1 arc7 ink_ring -2 -5 1
TAP LJ1 arc7 ink_ring -4 -4 -1   # arc7: a stroke crosses the ring between 6 and 7
TAP LJ1 arc8 ink_ring 0 -5 1
TAP LJ1 arc8 ink_ring -2 -5 -1   # arc8: a stroke crosses the ring between 7 and 8
TAP LJ1 arc9 ink_ring 2 -5 1
TAP LJ1 arc9 ink_ring 0 -5 -1   # arc9: a stroke crosses the ring between 8 and 9
TAP LJ1 arc10 ink_ring 4 -4 1
TAP LJ1 arc10 ink_ring 2 -5 -1   # arc10: a stroke crosses the ring between 9 and 10
TAP LJ1 arc11 ink_ring 5 -2 1
TAP LJ1 arc11 ink_ring 4 -4 -1   # arc11: a stroke crosses the ring between 10 and 11
TAP LJ1 arc12 ink_ring 5 0 1
TAP LJ1 arc12 ink_ring 5 -2 -1   # arc12: a stroke crosses the ring between 11 and 12
TAP LJ1 arc13 ink_ring 5 2 1
TAP LJ1 arc13 ink_ring 5 0 -1   # arc13: a stroke crosses the ring between 12 and 13
TAP LJ1 arc14 ink_ring 4 4 1
TAP LJ1 arc14 ink_ring 5 2 -1   # arc14: a stroke crosses the ring between 13 and 14
TAP LJ1 arc15 ink_ring 2 5 1
TAP LJ1 arc15 ink_ring 4 4 -1   # arc15: a stroke crosses the ring between 14 and 15

# ---- LJ2 branches = number of strokes crossing the ring, counted only on ink 
TAP LJ2 branches arc0 0 0 1
TAP LJ2 branches arc1 0 0 1
TAP LJ2 branches arc2 0 0 1
TAP LJ2 branches arc3 0 0 1
TAP LJ2 branches arc4 0 0 1
TAP LJ2 branches arc5 0 0 1
TAP LJ2 branches arc6 0 0 1
TAP LJ2 branches arc7 0 0 1
TAP LJ2 branches arc8 0 0 1
TAP LJ2 branches arc9 0 0 1
TAP LJ2 branches arc10 0 0 1
TAP LJ2 branches arc11 0 0 1
TAP LJ2 branches arc12 0 0 1
TAP LJ2 branches arc13 0 0 1
TAP LJ2 branches arc14 0 0 1
TAP LJ2 branches arc15 0 0 1
TAP LJ2 branches ink 0 0 4
BIAS LJ2 branches -4   # off the stroke the count is pushed below zero (relu)

# ---- LJ3 junction (3+ strokes meet) and crossing (4+), centred on the solid core of the stroke 
TAP LJ3 junction branches 0 0 1
TAP LJ3 junction ink_core 0 0 2
BIAS LJ3 junction -4.5   # junction: 3 strokes leave this point (T, Y, the join of a 9's tail)
TAP LJ3 crossing branches 0 0 1
TAP LJ3 crossing ink_core 0 0 2
BIAS LJ3 crossing -5.5   # crossing: 4 strokes leave this point (the X in the middle of an 8, the cross of a 4)

# ---- L4 outside seed: a background pixel with a clear ray to the border ----
TAP L4 outside inkL 0 0 -1
TAP L4 outside inkR 0 0 -1
TAP L4 outside inkU 0 0 -1
TAP L4 outside inkD 0 0 -1
TAP L4 outside ink 0 0 -4   # ink is never outside
BIAS L4 outside 4   # 4 - (walls on all 4 sides) >= 1 when at least one ray is clear
TAP L4 outside_f fatL 0 0 -1
TAP L4 outside_f fatR 0 0 -1
TAP L4 outside_f fatU 0 0 -1
TAP L4 outside_f fatD 0 0 -1
TAP L4 outside_f ink_fat 0 0 -4   # ink is never outside
BIAS L4 outside_f 4   # 4 - (walls on all 4 sides) >= 1 when at least one ray is clear
TAP L4 outside_c coreL 0 0 -1
TAP L4 outside_c coreR 0 0 -1
TAP L4 outside_c coreU 0 0 -1
TAP L4 outside_c coreD 0 0 -1
TAP L4 outside_c ink_core 0 0 -4   # ink is never outside
BIAS L4 outside_c 4   # 4 - (walls on all 4 sides) >= 1 when at least one ray is clear

# ---- L5 flood (looped 24x): outside spreads to 4-neighbours through background only 
TAP L5b outside outside_nb 0 0 1
TAP L5b outside ink 0 0 -4   # ink blocks the flood
TAP L5b outside_f outside_f_nb 0 0 1
TAP L5b outside_f ink_fat 0 0 -4   # same flood on 1 px thicker ink: gaps of 1-2 px are sealed
TAP L5b outside_c outside_c_nb 0 0 1
TAP L5b outside_c ink_core 0 0 -4   # same flood with only near-white walls: grey loop centres stay open

# ---- L6 hole: background the flood never reached ---------------------------
TAP L6 hole_x outside 0 0 -1
TAP L6 hole_x ink 0 0 -4
BIAS L6 hole_x 1   # hole_x = enclosed background (exact ink)
TAP L6 hole_f outside_f 0 0 -1
TAP L6 hole_f ink_fat 0 0 -4
BIAS L6 hole_f 1   # hole_f = enclosed once small gaps are sealed: a loop the writer left slightly open
TAP L6 hole_c outside_c 0 0 -1
TAP L6 hole_c ink_core 0 0 -4
BIAS L6 hole_c 1   # hole_c = enclosed by near-white ink: the small grey-centred loops of a thick 6, 8 or 9
TAP L6B hole hole_c 0 0 1
TAP L6B hole hole_x 0 0 1
TAP L6B hole hole_f 0 0 1   # hole = either kind
TAP L6D between_holes ink 0 0 1
TAP L6D between_holes holeU 0 0 1
TAP L6D between_holes holeD 0 0 1
BIAS L6D between_holes -2   # ink with a loop above and a loop below it: the waist of 8, B, g

# ---- L6F stems beside a bowl (position-free) -------------------------------
TAP L6F stem_lh run_v 0 0 1
TAP L6F stem_lh holeR 0 0 1
BIAS L6F stem_lh -1   # a vertical stroke with a hole somewhere to its right on the same row (b, p, D, P, B, R)
TAP L6F stem_rh run_v 0 0 1
TAP L6F stem_rh holeL 0 0 1
BIAS L6F stem_rh -1   # a vertical stroke with a hole somewhere to its left on the same row (d, q, a, 9)

# ---- L6I a stem continuing past its bowl: ascenders (b, d) and descenders (p, q) 
TAP L6I asc_l run_v 0 0 1
TAP L6I asc_l slhD 0 0 1
TAP L6I asc_l holeL 0 0 -1
TAP L6I asc_l holeR 0 0 -1
BIAS L6I asc_l -1   # a vertical stroke on a row with no hole, above a stem that has its bowl to the right: the ascender of a b
TAP L6I asc_r run_v 0 0 1
TAP L6I asc_r srhD 0 0 1
TAP L6I asc_r holeL 0 0 -1
TAP L6I asc_r holeR 0 0 -1
BIAS L6I asc_r -1   # a vertical stroke on a row with no hole, above a stem that has its bowl to the left: the ascender of a d
TAP L6I desc_l run_v 0 0 1
TAP L6I desc_l slhU 0 0 1
TAP L6I desc_l holeL 0 0 -1
TAP L6I desc_l holeR 0 0 -1
BIAS L6I desc_l -1   # a vertical stroke on a row with no hole, below a stem that has its bowl to the right: the descender of a p
TAP L6I desc_r run_v 0 0 1
TAP L6I desc_r srhU 0 0 1
TAP L6I desc_r holeL 0 0 -1
TAP L6I desc_r holeR 0 0 -1
BIAS L6I desc_r -1   # a vertical stroke on a row with no hole, below a stem that has its bowl to the left: the descender of a q

# ---- L6 bays: background walled on three sides, open on the fourth ---------
TAP L6 bay_R inkL 0 0 1
TAP L6 bay_R inkU 0 0 1
TAP L6 bay_R inkD 0 0 1
TAP L6 bay_R inkR 0 0 -4   # bay_R: nothing on the open side
TAP L6 bay_R ink 0 0 -4
TAP L6 bay_R outside 0 0 0.5   # must be reachable from outside (not a hole)
TAP L6 bay_R outside_f 0 0 0.5   # and not inside a nearly closed loop
BIAS L6 bay_R -3   # three walls + outside twice = 4 -> 1
TAP L6 bay_L inkR 0 0 1
TAP L6 bay_L inkU 0 0 1
TAP L6 bay_L inkD 0 0 1
TAP L6 bay_L inkL 0 0 -4   # bay_L: nothing on the open side
TAP L6 bay_L ink 0 0 -4
TAP L6 bay_L outside 0 0 0.5   # must be reachable from outside (not a hole)
TAP L6 bay_L outside_f 0 0 0.5   # and not inside a nearly closed loop
BIAS L6 bay_L -3   # three walls + outside twice = 4 -> 1
TAP L6 bay_U inkL 0 0 1
TAP L6 bay_U inkR 0 0 1
TAP L6 bay_U inkD 0 0 1
TAP L6 bay_U inkU 0 0 -4   # bay_U: nothing on the open side
TAP L6 bay_U ink 0 0 -4
TAP L6 bay_U outside 0 0 0.5   # must be reachable from outside (not a hole)
TAP L6 bay_U outside_f 0 0 0.5   # and not inside a nearly closed loop
BIAS L6 bay_U -3   # three walls + outside twice = 4 -> 1
TAP L6 bay_D inkL 0 0 1
TAP L6 bay_D inkR 0 0 1
TAP L6 bay_D inkU 0 0 1
TAP L6 bay_D inkD 0 0 -4   # bay_D: nothing on the open side
TAP L6 bay_D ink 0 0 -4
TAP L6 bay_D outside 0 0 0.5   # must be reachable from outside (not a hole)
TAP L6 bay_D outside_f 0 0 0.5   # and not inside a nearly closed loop
BIAS L6 bay_D -3   # three walls + outside twice = 4 -> 1

# ---- L6 gap: an empty row segment with ink above and below and nothing left or right (the dot of i, j) 
TAP L6 gap_v inkU 0 0 1
TAP L6 gap_v inkD 0 0 1
TAP L6 gap_v inkL 0 0 -4
TAP L6 gap_v inkR 0 0 -4
TAP L6 gap_v ink 0 0 -4
BIAS L6 gap_v -1   # gap = the character is split into an upper and a lower piece

