ZONE L7 mid_v@Bc mid_v 17.5:28~1.5 10.5:17.5~1.5 0.125
BIAS L7 mid_v@Bc -1.25
ZONE L7 mid_v@Br mid_v 17.5:28~1.5 17.5:28~1.5 0.125
BIAS L7 mid_v@Br -1.25

# ---- L7 shape features (a negative weight compares one region against another) 
ZONE L7 loop hole 0:28 0:28 0.25
BIAS L7 loop -0.5   # any loop, even a small one (MNIST loops can be a few pixels)
ZONE L7 loop_hi hole 0:14~2 0:28 0.25
ZONE L7 loop_hi hole 14:28~2 0:28 -0.25
BIAS L7 loop_hi -0.5   # loop sits in the upper half (9, P, e, q)
ZONE L7 loop_lo hole 14:28~2 0:28 0.25
ZONE L7 loop_lo hole 0:14~2 0:28 -0.25
BIAS L7 loop_lo -0.5   # loop sits in the lower half (6, b, d)
ZONE L7 loop_left hole 0:28 0:14~2 0.1
ZONE L7 loop_left hole 0:28 14:28~2 -0.1
BIAS L7 loop_left -0.6   # loop sits to the left
ZONE L7 loop_right hole 0:28 14:28~2 0.1
ZONE L7 loop_right hole 0:28 0:14~2 -0.1
BIAS L7 loop_right -0.6   # loop sits to the right
ZONE L7 hole_big hole 0:28 0:28 0.05
BIAS L7 hole_big -2   # a large enclosed area (O, 0, D, Q); an 8's two loops rarely add up to this
ZONE L7 waist between_holes 0:28 0:28 0.333333
BIAS L7 waist -0.333333   # a stroke with a loop above and below it
ZONE L7 wide_l ink 0:28 0:7~1 0.166667
BIAS L7 wide_l -0.333333   # ink reaches the left side
ZONE L7 wide_r ink 0:28 21:28~1 0.166667
BIAS L7 wide_r -0.333333   # ink reaches the right side
ZONE L7 gap gap_v 0:28 0:28 0.5
BIAS L7 gap -0.25   # the character is split top/bottom (i, j)

