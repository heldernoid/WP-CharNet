# ---- L8 concepts -----------------------------------------------------------
LINK L8 loop_tall hole@T 1
LINK L8 loop_tall hole@B 1
LINK L8 loop_tall waist -2
BIAS L8 loop_tall -1   # one loop reaching both top and bottom (0, O, D)
LINK L8 loop_two hole@T 1
LINK L8 loop_two hole@B 1
LINK L8 loop_two waist 1
BIAS L8 loop_two -2   # two loops stacked with a stroke between them (8, B)
LINK L8 narrow wide_l -1
LINK L8 narrow wide_r -1
BIAS L8 narrow 1   # ink stays near the centre column (1, l, I, i)
LINK L8 stem_l edge_l@T 1
LINK L8 stem_l edge_l@B 1
BIAS L8 stem_l -1   # a vertical stroke down the whole left side
LINK L8 stem_r edge_r@T 1
LINK L8 stem_r edge_r@B 1
BIAS L8 stem_r -1   # a vertical stroke down the whole right side
LINK L8 a_body loop_left 1
LINK L8 a_body vx1@r 1
LINK L8 a_body end_any@Br 1
BIAS L8 a_body -1.5   # an a: a bowl to the left of a straight stem that ends in a tail at the bottom right (all three together)
LINK L8 tail_below_r loop_hi 1
LINK L8 tail_below_r hx1@D 1
LINK L8 tail_below_r marg_l@B 1
BIAS L8 tail_below_r -1.5   # a bowl at the top with one stroke hanging below it on the right, leaving the bottom left empty (q, g)
LINK L8 tail_below_l loop_hi 1
LINK L8 tail_below_l hx1@D 1
LINK L8 tail_below_l marg_r@B 1
BIAS L8 tail_below_l -1.5   # a bowl at the top with one stroke hanging below it on the left, leaving the bottom right empty (p)
LINK L8 B_body run_v@l 1
LINK L8 B_body hole@T 1
LINK L8 B_body hole@B 1
LINK L8 B_body waist 1
BIAS L8 B_body -3   # a B: two bowls stacked with a waist between them, on a straight stem down the left (all together)
LINK L8 b_body asc_l@A 1
LINK L8 b_body loop_lo 1
BIAS L8 b_body -1   # a b: a bowl low down, its stem continuing above it on the bowl's left (wherever the letter sits)
LINK L8 d_body asc_r@A 1
LINK L8 d_body loop_lo 1
BIAS L8 d_body -1   # a d: a bowl low down, its stem continuing above it on the bowl's right (wherever the letter sits)
LINK L8 D_body stem_lh@T 1
LINK L8 D_body stem_lh@B 1
LINK L8 D_body hole@T 1
LINK L8 D_body hole@B 1
LINK L8 D_body waist -1
BIAS L8 D_body -3   # a D: one tall bowl with a straight stem beside it from the top band to the bottom band
LINK L8 E_arms bay_R@T 1
LINK L8 E_arms bay_R@B 1
LINK L8 E_arms end_any@M 1
BIAS L8 E_arms -2   # an E: two openings to the right, one above and one below a middle arm that ends in the middle (wherever the letter sits)
LINK L8 e_body loop_hi 1
LINK L8 e_body bay_R@A 1
BIAS L8 e_body -1   # an e: a loop at the top and an opening to the right below it
LINK L8 S_body run_d2@M 1
LINK L8 S_body ax2@M 1
BIAS L8 S_body -1   # an S: its spine runs down to the right through the middle, and the / lines there cross it twice (wherever it sits)
LINK L8 line run_v@A 1
LINK L8 line run_d1@A 1
LINK L8 line run_d2@A 1
BIAS L8 line 0   # a long straight stroke in any direction (one is enough)

# ---- L9 styles: positive evidence sums to 1, each contradiction subtracts --
LINK L9 s:0/oval hole_big 0.75
LINK L9 s:0/oval loop 0.25
LINK L9 s:0/oval waist -0.75
LINK L9 s:0/oval gap -0.3
LINK L9 s:0/oval bay_R@T -0.3
